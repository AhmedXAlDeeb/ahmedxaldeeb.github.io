---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---
<BaseLayout title="Page not found — Digital Atlas" description="The page you requested does not exist." noindex>
<div class="container page">
  <svg class="lost" viewBox="0 0 60 96" role="img" aria-label="The walker looks at a map, lost">
    <g stroke="var(--character-stroke)" stroke-width="2.4" fill="var(--character-fill)" stroke-linecap="round">
      <circle cx="30" cy="12" r="8"/>
      <path d="M30 22 v26 M30 48 l-8 22 M30 48 l8 22 M30 30 l-10 8"/>
      <rect x="34" y="34" width="18" height="14" rx="2" fill="none"/>
      <path d="M38 34 l4 14 M46 34 l-4 14" stroke-width="1.4"/>
      <path d="M18 22 q6 -6 12 0" stroke="var(--character-accent)"/>
    </g>
  </svg>
  <h1>404 — off the map</h1>
  <p>The walker took a wrong turn. This coordinate doesn't exist.</p>
  <ul>
    <li><a href={url('/')}>Home</a></li>
    <li><a href={url('/mentorship/')}>Mentorship</a></li>
    <li><a href={url('/learn/')}>Learn</a></li>
    <li><a href={url('/contact/')}>Contact</a></li>
  </ul>
</div>
</BaseLayout>
<style>
  .page { padding-block: 4rem; } .lost { height: 120px; width: auto; }
</style>
