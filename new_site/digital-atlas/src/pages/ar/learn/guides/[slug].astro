---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { url, slugOf, live } from '../../../../lib/url';
import { t } from '../../../../i18n/ui';

export async function getStaticPaths() {
  const items = (await getCollection('guides')).filter(live('ar'));
  return items.map((entry: any) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}
const { entry } = Astro.props as any;
const { Content } = await render(entry);
const stale = Date.now() - new Date(entry.data.lastVerified).getTime() > 365 * 24 * 3600 * 1000;
---
<BaseLayout title={`${entry.data.title} — أدلة`} description={entry.data.summary} type="article" lang="ar">
<div class="container page narrow">
  <nav aria-label="Breadcrumb"><a href={url('/ar/learn/')}>تعلّم</a> / <span aria-current="page">{entry.data.title}</span></nav>
  <p class="badge">{t('ar', 'lastVerified')}: {entry.data.lastVerified} · {entry.data.contentType}</p>
  {stale && <p class="warn" role="alert">⚠ هذا الدليل أقدم من ١٢ شهرًا. تحقق من المواعيد والرسوم وقواعد التأشيرة في المصدر الرسمي قبل أن تتصرف.</p>}
  <h1>{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>
  <div class="section--invert block">
    <article class="prose"><Content /></article>
  </div>
  {entry.data.sources.length ? (<section><h2>{t('ar', 'sources')}</h2><ul>{entry.data.sources.map((s: any) => <li><a href={s.href}>{s.label}</a></li>)}</ul></section>) : null}
  <p class="disclaimer">{t('ar', 'disclaimer')}</p>
</div>
</BaseLayout>
<style>
  .page { padding-block: 3rem; } .narrow { max-width: var(--reading-width); }
  .badge { display: inline-block; border: 1px solid var(--color-border-strong); border-radius: var(--radius-pill); padding: 0.3rem 0.9rem; color: var(--color-text-secondary); }
  .warn { border: 1px solid var(--color-accent); border-radius: var(--radius-md); padding: 0.8rem 1rem; }
  .lede { color: var(--color-text-secondary); }
  .disclaimer { color: var(--color-text-muted); font-size: var(--text-sm); border-top: 1px solid var(--color-divider); padding-top: 1rem; }
</style>
