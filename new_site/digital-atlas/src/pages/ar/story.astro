---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Timeline from '../../components/Timeline.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { url } from '../../lib/url';

const booking = site.bookingUrl || url('/ar/contact/');
const timeline = [
  { period: 'تخرّج', title: 'بكالوريوس هندسة النظم والطبية الحيوية', org: 'جامعة القاهرة، مصر — المعدل 3.41/4.00', logo: '/img/companies/cairo university.jpeg', logoAlt: 'شعار جامعة القاهرة', details: ['معالجة الصور الطبية والإشارات الرقمية وتعلم الآلة والرؤية الحاسوبية'] },
  { period: 'الآن', title: 'مهندس ذكاء اصطناعي', details: ['بناء وبحث في أنظمة الذكاء الاصطناعي'] },
  { period: 'فبراير ٢٠٢٤ – الآن', title: 'مساعد أبحاث الرؤية الحاسوبية', org: 'جامعة النيل — مركز علوم المعلومات', logo: '/img/companies/NU.jpg', logoAlt: 'شعار جامعة النيل', details: ['الكشف المبكر عن الوذمة الحليمية من صور قاع العين مع أطباء'] },
  { period: '٢٠٢٤ – ٢٠٢٥', title: 'تدريب في البيانات والذكاء الاصطناعي', org: 'Synapse Analytics · IBM Egypt · innovay.io · IDH', details: ['خطوط تعلم آلة إنتاجية ومعالجة لغات وهندسة بيانات وتحليلات واسعة'] },
  { period: '٢٠٢٤', title: 'تكريم بحثي', org: 'IEEE · جامعة النيل · هاكاثون Machathon', details: ['المركز الأول في مسابقة IEEE المصرية لأوراق الطلاب؛ والمركز الأول في منتدى جامعة النيل؛ والرابع في هاكاثون Machathon'] },
  { period: 'قبل التخرج', title: 'عروض ماجستير بين يدي', details: ['التقديم على عشرات الفرص خلال عامين من دراسة العملية'] },
  { period: 'الآن', title: 'إرشاد فردي', org: '١٠ مقاعد شهريًا', details: ['مساعدة الأصدقاء والزملاء في إيجاد الفرص ورفع الدرجات وإكمال الطلبات'] },
];
---
<BaseLayout title="قصتي — أحمد سليمان" description="الدراسة الممولة ليست حظًا. تعلم أحمد العملية والآن يعلّمها — من جامعة القاهرة إلى هندسة الذكاء الاصطناعي إلى عروض الماجستير." lang="ar">
<div class="container page">
  <SectionHeading eyebrow="القصة" title="الدراسة الممولة ليست حظًا. تعلمت العملية، والآن أعلّمها." level={1} />
  <img class="headshot" src="/img/companies/IEEE_Presentation_ver.jpg" alt="أحمد سليمان أثناء عرض تقديمي" width="560" decoding="async" />
  <div class="reading">
    <h2>من أين بدأت</h2>
    <p>أنا أحمد سليمان. درست الهندسة في جامعة القاهرة، وانجذبت إلى النقطة التي تلتقي فيها الآلة بجسم الإنسان، واستخدمت الذكاء الاصطناعي للربط بينهما. أعمل اليوم مهندس ذكاء اصطناعي. وكما يرى كثير من طلاب الهندسة في مصر، كنت أنظر إلى الدراسة الممولة بالخارج كشيء يحدث للآخرين: كلام عن أساتذة ومنح وعروض، بلا خريطة.</p>
  </div>

  <div class="reading">
    <h2>نقطة التحول</h2>
    <p>في لحظة ما توقفت عن سؤال «هل سأُقبل؟» وبدأت أسأل «ما الذي يحسم الأمر فعلًا؟». غيّر هذا السؤال كل شيء. تعاملت معه كمشكلة هندسية: أجمع المعلومات، وأختبر الافتراضات، وأكرر. لمدة عامين تقريبًا درست كيف يعمل القبول والتمويل حقًا: كيف يختار المشرفون طلابهم، وماذا يجب أن يفعل خطاب الدافع، وأين يقع اختبار اللغة، وأي الفرص ممولة فعلًا وأيها يبدو كذلك فقط.</p>
  </div>

  <div class="reading">
    <h2>ما فعلته</h2>
    <p>لم أفعل ذلك وحدي، ولم أفعله مرة واحدة. تعلمت من أشخاص سبق أن حصلوا على مقاعد ممولة: ماذا أرسلوا، وكيف كتبوا، وماذا كانوا سيغيّرون. ثم قدّمت على عشرات الفرص، ولاحظت ما ينجح وما لا ينجح، وصححت أسلوبي في كل جولة. وقبل تخرجي كانت بين يدي عروض ماجستير.</p>
  </div>


  <div class="reading">
    <h2>لماذا أرشد</h2>
    <p>انتبه أصدقائي. واحدًا تلو الآخر طلبوا مني النظر في خطط الآيلتس، ومساعدتهم في إيجاد مشرفين، وقراءة طلبات التقديم. ساعدت كثيرين منهم في إيجاد فرص مناسبة ورفع درجاتهم وإرسال طلبات يفخرون بها. عندها فهمت أن هذا الطريق يمكن تعلّمه. الموهبة نادرًا ما تكون الفارق؛ الفارق غالبًا هو المعلومة والتنظيم والملاحظات الصادقة. أحب مساعدة الناس، وأريد أن أفعل ذلك مع عدد أكبر من الطلاب، بحرص. لهذا أقبل عشرة طلاب شهريًا فقط، بشكل فردي: فالإرشاد لا ينجح إلا حين يكون شخصيًا.</p>
  </div>

  <div class="reading">
    <h2>ما الذي أعد به</h2>
    <p>لا أستطيع أن أعدك بقبول أو تمويل، فهذه القرارات تعود إلى الجامعات وجهات التمويل. أعدك بخطة واضحة وملاحظات صادقة واهتمام كامل.</p>
  </div>

  <CtaBand title="امشِ هذا الطريق مع مرشد." summary="مكالمة مجانية عشرون دقيقة: ملفك وأهدافك ورأي صادق في الملاءمة." primaryHref={booking} primaryLabel="احجز مكالمة تعريفية مجانية" secondaryHref="/ar/mentorship/" secondaryLabel="اطلع على الإرشاد" />
</div>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:'Ahmed Soliman',email:`mailto:${site.email}`,affiliation:'Cairo University',sameAs:[site.profiles.github,site.profiles.linkedin]})} />
</BaseLayout>
<style>
  .page { padding-block: 3rem; display: grid; gap: 1rem; }
  .headshot { border-radius: var(--radius-lg); border: var(--glass-border); width: 100%; max-width: 560px; height: auto; }
</style>
