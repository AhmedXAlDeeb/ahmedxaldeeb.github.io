---
/**
 * EarthScene — fixed background journey layer for Home only.
 * Earth SVG + stars + monoline walker. Scroll sets --scene-parallax (0..1);
 * CSS rotates Earth, advances walk cycle, highlights pins. No-JS fallback:
 * static SVG (Earth + standing walker) rendered by markup+CSS alone.
 * Container is aria-hidden; all facts exist as HTML text elsewhere.
 */
interface Pin { label: string; at: number; canada?: boolean }
interface Props { front?: boolean }
const { front = false } = Astro.props as Props;
const pins: Pin[] = [
  { label: 'English test', at: 0.12 },
  { label: 'Supervisor', at: 0.3 },
  { label: 'Application', at: 0.48 },
  { label: 'Documents', at: 0.64 },
  { label: 'Visa', at: 0.8 },
  { label: 'Canada', at: 0.94, canada: true },
];
---
<div class:list={['earth-scene', { 'earth-scene--front': front }]} data-earth-scene aria-hidden="true">
  <svg class="stars" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" focusable="false">
    <g fill="var(--star-color)">
      <circle cx="60" cy="80" r="1.4" opacity="0.5"/><circle cx="180" cy="200" r="1" opacity="0.3"/>
      <circle cx="300" cy="90" r="1.6" opacity="0.55"/><circle cx="430" cy="260" r="1" opacity="0.3"/>
      <circle cx="560" cy="70" r="1.3" opacity="0.5"/><circle cx="690" cy="180" r="1" opacity="0.35"/>
      <circle cx="820" cy="90" r="1.5" opacity="0.5"/><circle cx="950" cy="230" r="1" opacity="0.3"/>
      <circle cx="1080" cy="110" r="1.4" opacity="0.5"/><circle cx="1150" cy="300" r="1" opacity="0.3"/>
      <circle cx="240" cy="340" r="1" opacity="0.25"/><circle cx="760" cy="330" r="1" opacity="0.25"/>
    </g>
  </svg>
  <div class="earth-wrap">
    <svg class="earth" viewBox="0 0 1000 1000" focusable="false">
      <defs>
        <filter id="rimGlow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="10" result="b"/>
          <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <g class="earth-spin" data-earth-spin>
        <circle cx="500" cy="500" r="470" fill="var(--earth-fill)"/>
        <g stroke="var(--earth-outline)" stroke-width="2" opacity="0.6" fill="none">
          <path d="M180 420 q60 -50 140 -40 q70 8 120 -30 q40 -30 90 -20"/>
          <path d="M560 300 q80 -20 150 10 q60 25 110 5"/>
          <path d="M220 580 q70 40 150 30 q90 -12 160 20 q60 28 120 10"/>
          <path d="M420 700 q80 30 170 15 q70 -12 130 10"/>
          <path d="M650 520 q60 -10 110 15"/>
        </g>
        <circle cx="500" cy="500" r="470" fill="none" stroke="var(--earth-rim)" stroke-width="3" filter="url(#rimGlow)"/>
        {pins.map((p) => {
          // Static fallback along the top cap; JS refines to the exact
          // viewport-fitted arc on load (see script below).
          const a = Math.PI / 2 + (0.5 - p.at) * 1.5;
          const x = 500 + Math.cos(a) * 470;
          const y = 500 - Math.sin(a) * 470;
          return (
            <g class="pin" data-pin-at={p.at} transform={`translate(${x} ${y})`}>
              <circle r={p.canada ? 9 : 6} fill={p.canada ? 'var(--earth-rim)' : 'var(--earth-outline)'} opacity="0.9"/>
              {p.canada && <path d="M0 -4 v8 M-3 -1 l3 2 3 -2" stroke="var(--character-fill)" stroke-width="1.4"/>}
            </g>
          );
        })}
      </g>
    </svg>
    <svg class="walker" viewBox="0 0 60 72" focusable="false">
      <g stroke="var(--character-stroke)" stroke-width="2.4" fill="var(--character-fill)" stroke-linecap="round">
        <circle cx="30" cy="12" r="8"/>
        <path d="M30 22 v26"/>
        <g class="leg-a"><path d="M30 48 l-9 22"/></g>
        <g class="leg-b"><path d="M30 48 l9 22"/></g>
        <path d="M30 30 l-12 8"/>
        <path d="M30 30 l12 6"/>
        <rect x="36" y="30" width="12" height="16" rx="3"/>
        <rect x="39" y="22" width="6" height="9" rx="1.5" fill="var(--character-accent)" stroke="none"/>
      </g>
    </svg>
  </div>
  <div class="scroll-hint">
    <span class="brackets" aria-hidden="true"></span>
    <span>Scroll — the journey</span>
  </div>
</div>
<script>
  const root = document.querySelector('[data-earth-scene]');
  const wrap = root?.querySelector('.earth-wrap');
  const walker = root?.querySelector('.walker');
  const footer = document.querySelector('.site-footer');
  const spin = document.querySelector('[data-earth-spin]');
  const pins = Array.from(document.querySelectorAll('[data-pin-at]'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rtl = document.documentElement.dir === 'rtl';
  const dirSign = rtl ? -1 : 1;
  let ticking = false;
  let wrapSize = 0;

  function measure() {
    wrapSize = wrap ? wrap.clientWidth : 0;
  }

  // Walker + pin placement on the visible arc, in .earth-wrap coordinates.
  // Circle: center (S/2, S/2), radius 0.47S. Feet must stay above the fold.
  function place(p: number) {
    if (!wrapSize || !walker) return;
    const S = wrapSize;
    const r = 0.47 * S;
    const horizonPx = window.innerHeight * 0.28;
    const smin = (S / 2 - horizonPx + 8) / r;
    const half = Math.PI / 2 - Math.asin(Math.max(-1, Math.min(1, smin)));
    const a = Math.PI / 2 + dirSign * (1 - 2 * p) * half * 0.94;
    const x = S / 2 + r * Math.cos(a);
    const y = S / 2 - r * Math.sin(a);
    const tilt = (-(a - Math.PI / 2) * 180) / Math.PI;
    const w = walker as unknown as HTMLElement;
    w.style.left = `${x.toFixed(1)}px`;
    w.style.top = `${y.toFixed(1)}px`;
    w.style.transform = `translate(-50%, -100%) rotate(${(tilt * 0.6).toFixed(1)}deg)`;
    pins.forEach((el) => {
      const at = parseFloat(el.getAttribute('data-pin-at') || '0');
      const pa = Math.PI / 2 + dirSign * (1 - 2 * at) * half * 0.94;
      const px = 500 + 470 * Math.cos(pa);
      const py = 500 - 470 * Math.sin(pa);
      el.setAttribute('transform', `translate(${px.toFixed(1)} ${py.toFixed(1)})`);
    });
  }

  function update() {
    ticking = false;
    if (!root) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    root.classList.add('is-live');
    place(p);
    // When the footer scrolls into view, lift the planet so its dark disc
    // sits behind the footer text (rim drops below the copy). Eases with scroll.
    if (!reduce && footer) {
      const H = window.innerHeight;
      const top = footer.getBoundingClientRect().top;
      const q = Math.min(1, Math.max(0, (H - top) / (H * 0.6)));
      const liftMax = Math.min(H * 0.36, 380);
      root.style.setProperty('--earth-lift', `${(q * liftMax).toFixed(1)}px`);
    }
    if (spin) spin.setAttribute('transform', `rotate(${(-8 + p * 36).toFixed(2)} 500 500)`);
    let best = 0, bestD = 2;
    pins.forEach((el, i) => {
      const at = parseFloat(el.getAttribute('data-pin-at') || '0');
      const d = Math.abs(at - p);
      if (d < bestD) { bestD = d; best = i; }
      el.classList.toggle('pin-active', false);
    });
    if (pins[best]) pins[best].classList.add('pin-active');
    root.classList.toggle('is-walking', !reduce && window.scrollY > 40);
  }
  function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
  function onResize() { measure(); update(); }
  if (root && !reduce) {
    measure();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) update(); });
  } else if (root) {
    measure();
    update();
  }
</script>
<style>
  .earth-scene {
    position: fixed; inset: 0; z-index: var(--z-orbit-scene); pointer-events: none;
    overflow: clip; --scene-parallax: 0; --earth-lift: 0px;
  }
  /* Front mode (home): planet covers page content; header/footer stay above. */
  .earth-scene--front { z-index: 2; }
  .stars { position: absolute; inset: 0; width: 100%; height: 100%; }
  .earth-wrap { position: absolute; left: 57%; bottom: 0; width: var(--earth-size); height: var(--earth-size); transform: translate(-50%, calc(100% - var(--horizon-offset) - var(--earth-lift))); }
  .earth { width: 100%; height: 100%; display: block; }
  .pin { transition: opacity 0.3s, scale 0.3s; opacity: 0.55; transform-box: fill-box; transform-origin: center; }
  .pin-active { opacity: 1; scale: 1.45; }
  .walker {
    position: absolute; left: 50%; top: -2vh; width: auto; height: 11vh; min-height: 72px;
    transform: translateX(-50%);
  }
  /* Live mode positions via inline left/top; pivot rotation at the feet. */
  .earth-scene.is-live .walker { transform-origin: 50% 100%; }
  .earth-scene.is-walking .leg-a { animation: stride-a 0.7s ease-in-out infinite alternate; transform-origin: 30px 48px; }
  .earth-scene.is-walking .leg-b { animation: stride-b 0.7s ease-in-out infinite alternate; transform-origin: 30px 48px; }
  @keyframes stride-a { from { transform: rotate(-14deg); } to { transform: rotate(14deg); } }
  @keyframes stride-b { from { transform: rotate(14deg); } to { transform: rotate(-14deg); } }
  .scroll-hint {
    position: absolute; left: 57%; bottom: calc(var(--horizon-offset) + 14vh); transform: translateX(-50%);
    color: var(--color-text-muted); font-size: var(--text-sm); display: flex; gap: 0.6rem; align-items: center;
  }
  .brackets { width: 1.4rem; height: 1.4rem; border: 1px solid var(--color-border-strong); border-radius: 4px; display: inline-block; }
  @media (max-width: 48rem) {
    .earth-scene { opacity: 0.85; }
    .walker { height: 9vh; min-height: 60px; }
    .scroll-hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .earth-scene.is-walking .leg-a, .earth-scene.is-walking .leg-b { animation: none; }
  }
</style>
