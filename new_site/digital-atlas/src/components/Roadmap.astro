---
import type { RoadmapNode } from '../data/mentorship';

interface Props {
  nodes: RoadmapNode[];
  lang?: 'en' | 'ar';
  outputLabel?: string;
}
const { nodes, lang = 'en', outputLabel } = Astro.props as Props;
const label = outputLabel ?? (lang === 'ar' ? 'المخرَج' : 'Output');
const t = (n: RoadmapNode, k: 'title' | 'blurb' | 'deliverable') =>
  lang === 'ar' ? n[`${k}Ar` as keyof RoadmapNode] : n[k];
---
<ol class="roadmap">
  {nodes.map((n, i) => (
    <li class="node reveal" id={`stage-${n.id}`}>
      <span class="marker" aria-hidden="true">
        {i === 0 ? (
          <svg viewBox="0 0 24 36" class="glyph"><g stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"><circle cx="12" cy="5" r="3.4"/><path d="M12 9v10M12 19l-4 9M12 19l4 9M12 12l-5 3M12 12l5 3"/></g></svg>
        ) : i === nodes.length - 1 ? (
          <svg viewBox="0 0 24 36" class="glyph"><path d="M12 4l2.2 4.6 3-1.6-.6 3.4 3 1.4-2.6 2.2 1.4 3.2-3.4-.8L12 20l-3-3.6-3.4.8 1.4-3.2L4.4 11.8l3-1.4-.6-3.4 3 1.6z" fill="currentColor"/><path d="M12 20v12" stroke="currentColor" stroke-width="1.8"/></svg>
        ) : (
          <span class="num">{i + 1}</span>
        )}
      </span>
      <div class="body">
        <p class="node-title"><span class="n">{i + 1}</span> {t(n, 'title')}</p>
        <p class="blurb">{t(n, 'blurb')}</p>
        <p class="output"><span class="output-label">{label}:</span> {t(n, 'deliverable')}</p>
      </div>
    </li>
  ))}
</ol>
<style>
  .roadmap { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; position: relative; }
  .node { display: flex; gap: 1rem; align-items: flex-start; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-elevated); padding: 1.1rem 1.25rem; position: relative; }
  .marker { flex-shrink: 0; width: 2.5rem; height: 2.5rem; border: 1px solid var(--color-border-strong); border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--color-bg); font-weight: 700; }
  .glyph { width: 1.4rem; height: 2rem; }
  .num { font-variant-numeric: tabular-nums; }
  .body { display: grid; gap: 0.25rem; }
  .node-title { margin: 0; font-weight: 700; }
  .node-title .n { font-variant-numeric: tabular-nums; color: var(--color-text-muted); font-weight: 400; }
  .blurb { margin: 0; color: var(--color-text-muted); font-size: var(--text-sm); }
  .output { margin: 0.3rem 0 0; font-size: var(--text-sm); }
  .output-label { display: inline-block; border: 1px solid var(--color-border-strong); border-radius: var(--radius-pill); padding: 0.1rem 0.6rem; font-size: var(--text-xs); margin-inline-end: 0.4rem; }
  @media (min-width: 52rem) {
    .roadmap { grid-template-columns: repeat(3, 1fr); }
    .roadmap::before { content: ""; position: absolute; top: 2.35rem; inset-inline: 4rem; border-top: 2px solid var(--color-border-strong); opacity: 0.6; }
    .node { flex-direction: column; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .roadmap::before { animation: draw 1.2s var(--ease-standard) both; }
    @keyframes draw { from { opacity: 0; } to { opacity: 0.6; } }
  }
</style>
