---
import { url } from '../lib/url';
interface Props { title: string; href: string; date?: string; tags?: string[]; summary?: string; kind?: string; }
const p = Astro.props as Props;
---
<article class="card-simple card reveal">
  <div class="meta">{p.date && <time>{p.date}</time>}{p.kind && <span class="tag">{p.kind}</span>}</div>
  <h3><a href={url(p.href)}>{p.title}</a></h3>
  {p.summary && <p class="summary">{p.summary}</p>}
  {p.tags?.length ? <div class="tags">{p.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}</div> : null}
</article>
<style>
  .card { display: flex; flex-direction: column; gap: 0.55rem; }
  .meta { display: flex; gap: 0.5rem; font-size: var(--text-xs); color: var(--color-text-muted); }
  .tag { border: 1px solid var(--color-border-strong); border-radius: var(--radius-pill); padding: 0.15rem 0.6rem; color: var(--color-text-secondary); }
  h3 { margin: 0; font-size: 1.1rem; } h3 a { color: var(--color-text); text-decoration: none; }
  .summary { color: var(--color-text-muted); margin: 0; font-size: var(--text-sm); }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
</style>
