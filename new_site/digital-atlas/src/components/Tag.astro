---
interface Props { tag?: string; }
const { tag } = Astro.props as Props;
---
<span class="tag">{tag ?? <slot />}</span>
<style>
  .tag { display: inline-flex; align-items: center; border: 1px solid var(--color-border-strong); border-radius: var(--radius-pill); padding: 0.2rem 0.7rem; font-size: var(--text-xs); color: var(--color-text-secondary); background: var(--color-bg-glass-strong); }
</style>
