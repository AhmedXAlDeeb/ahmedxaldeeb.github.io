---
// Compact static horizon strip for inner pages — brand continuity at near-zero cost.
---
<div class="strip" aria-hidden="true">
  <svg viewBox="0 0 1200 90" preserveAspectRatio="xMidYMax slice" focusable="false">
    <rect width="1200" height="90" fill="none"/>
    <g fill="var(--star-color)" opacity="0.5">
      <circle cx="80" cy="18" r="1.2"/><circle cx="210" cy="34" r="1"/><circle cx="350" cy="12" r="1.3"/>
      <circle cx="520" cy="26" r="1"/><circle cx="700" cy="14" r="1.2"/><circle cx="880" cy="30" r="1"/>
      <circle cx="1040" cy="16" r="1.3"/><circle cx="1140" cy="40" r="1"/>
    </g>
    <path d="M -50 120 A 650 650 0 0 1 1250 120" fill="var(--earth-fill)" stroke="var(--earth-rim)" stroke-width="2"/>
    <g stroke="var(--earth-outline)" stroke-width="1" opacity="0.6" fill="none">
      <path d="M 300 82 q 30 -12 60 -2 q 25 8 55 -4"/>
      <path d="M 700 86 q 35 -10 70 0"/>
    </g>
    <g stroke="var(--character-stroke)" stroke-width="1.6" fill="var(--character-fill)">
      <circle cx="600" cy="52" r="4"/>
      <path d="M600 56 v10 M600 60 l-6 3 M600 60 l6 3 M600 66 l-5 9 M600 66 l5 9"/>
    </g>
    <path d="M604 62 l7 -2" stroke="var(--character-accent)" stroke-width="2"/>
  </svg>
</div>
<style>
  .strip { border-bottom: 1px solid var(--color-divider); background: var(--color-bg); }
  .strip svg { display: block; width: 100%; height: 72px; }
</style>
